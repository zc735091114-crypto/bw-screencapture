<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.bharatwallet.paytmstmt" android:versionCode="4" android:versionName="0.4-vecb">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!--
      Package visibility. From Android 11 an app targeting a recent SDK sees
      almost nothing else on the device unless it declares it here. Without this
      block the wallet apps are invisible: getPackageInfo reports them as not
      installed and the tester is told Paytm is missing from a phone that has
      it. Every package the capture allowlist names must be declared below.
    -->
    <queries>
        <package android:name="net.one97.paytm"/>
        <package android:name="com.phonepe.app"/>
        <package android:name="com.mobiwik.android"/>
        <package android:name="money.super.payments"/>

        <!-- Needed to open a wallet's own launcher screen. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>

    <application android:label="BW Statement Check" android:debuggable="true" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>

        <!--
          The accessibility service. Without this declaration
          UpiCaptureService cannot start at all: an AccessibilityService is inert
          unless it is declared here with the BIND_ACCESSIBILITY_SERVICE
          permission and the accessibilityservice action. Its absence was why
          Settings showed no toggle and enabled_accessibility_services stayed
          null regardless of how often the tester looked.

          Capability granted: reading window content from the allowlisted wallet
          packages only (see CapturePolicy.WALLET_PACKAGES). The service
          requests canPerformGestures=false and canRequestFilterKeyEvents=false
          and never calls performAction, so it cannot tap, swipe or type into a
          wallet even if the code were changed to try. The structural gate in
          build.py re-checks that on every build.

          exported=true is required: the system binds the service, not this app.
          BIND_ACCESSIBILITY_SERVICE is a signature-level system permission, so
          only the platform may bind it.
        -->
        <service
            android:name=".UpiCaptureService"
            android:exported="true"
            android:label="BW UPI capture"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>
    </application>
</manifest>